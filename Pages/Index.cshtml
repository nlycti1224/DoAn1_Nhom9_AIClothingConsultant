@page
@model IndexModel
@{
    ViewData["Title"] = "VELOUR — Thời Trang Thiết Kế & Trợ Lý Phối Đồ AI";
}

<!-- TOP ANNOUNCEMENT BAR -->
<div class="announcement-bar">
    <div class="announcement-inner">
        <span>MIỄN PHÍ GIAO HÀNG ĐƠN TỪ 499.000₫</span>
        <span class="ann-dot"></span>
        <span class="ann-promo" onclick="copyPromoCode()">NHẬP MÃ <strong>VELOUR15</strong> GIẢM 15% ĐƠN ĐẦU TIÊN</span>
        <span class="ann-dot"></span>
        <span class="ann-ai" onclick="openChat()">TƯ VẤN PHỐI ĐỒ CÙNG VELOUR AI 24/7</span>
    </div>
</div>

<!-- STICKY EDITORIAL HEADER (JM / UNIQLO STYLE) -->
<header class="navbar">
    <div class="nav-container">
        <a class="brand-logo" onclick="filterCategory('All')" aria-label="VELOUR Trang chủ">
            <svg class="brand-mark" viewBox="0 0 28 28" width="22" height="22" fill="none" aria-hidden="true">
                <rect x="2" y="2" width="24" height="24" stroke="currentColor" stroke-width="1.4"/>
                <path d="M8.5 8.5L14 19.5L19.5 8.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/>
            </svg>
            <span class="brand-wordmark">VELOUR</span>
        </a>

        <nav class="nav-links" aria-label="Danh mục chính">
            <a class="cat-link active" data-cat="All" onclick="filterCategory('All')">Tất cả</a>
            <a class="cat-link" data-cat="Hàng mới" onclick="filterCategory('Hàng mới')">Hàng mới</a>
            <a class="cat-link" data-cat="Váy đầm" onclick="filterCategory('Váy đầm')">Váy đầm</a>
            <a class="cat-link" data-cat="Áo" onclick="filterCategory('Áo')">Áo</a>
            <a class="cat-link" data-cat="Chân váy" onclick="filterCategory('Chân váy')">Chân váy</a>
            <a class="cat-link" data-cat="Áo khoác" onclick="filterCategory('Áo khoác')">Áo khoác</a>
            <a class="cat-link" data-cat="Đồ nam" onclick="filterCategory('Đồ nam')">Đồ nam</a>
            <a class="cat-link cat-sale" data-cat="Ưu đãi" onclick="filterCategory('Ưu đãi')">Ưu đãi</a>
        </nav>

        <div class="nav-actions">
            <div class="search-box">
                <svg class="ui-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/>
                    <path d="M20 20L16.2 16.2"/>
                </svg>
                <input type="text" id="navSearch" placeholder="Tìm sản phẩm, chất liệu..." />
            </div>

            <button class="icon-action-btn" onclick="openChat()" title="Tư vấn phối đồ cùng AI" aria-label="Mở trợ lý phối đồ AI">
                <svg class="ui-ico" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3L13.8 8.2L19 10L13.8 11.8L12 17L10.2 11.8L5 10L10.2 8.2L12 3Z"/>
                    <path d="M19 15L19.9 17.6L22.5 18.5L19.9 19.4L19 22L18.1 19.4L15.5 18.5L18.1 17.6L19 15Z"/>
                </svg>
            </button>

            <button class="icon-action-btn cart-btn-wrap" onclick="toggleCartDrawer()" title="Giỏ hàng" aria-label="Mở giỏ hàng">
                <svg class="ui-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 8H18L19.2 20H4.8L6 8Z"/>
                    <path d="M9 8V6.5C9 4.84 10.34 3.5 12 3.5C13.66 3.5 15 4.84 15 6.5V8"/>
                </svg>
                <span class="cart-badge" id="cartBadge">0</span>
            </button>
        </div>
    </div>
</header>

<!-- EDITORIAL HERO LOOKBOOK -->
<section class="hero-section">
    <div class="hero-container">
        <div class="hero-content">
            <div class="hero-eyebrow">BỘ SƯU TẬP XUÂN — HÈ 2026</div>
            <h1 class="hero-title">Thanh Lịch Trong<br>Từng Đường Nét</h1>
            <p class="hero-sub">
                Thiết kế tinh giản chuẩn phom dáng hiện đại từ voan tơ, linen tự nhiên và len dệt kim cao cấp.
                Trải nghiệm gợi ý phối đồ cá nhân hóa tức thì cùng <strong>Velour AI Stylist</strong>.
            </p>
            <div class="hero-cta">
                <button class="btn-primary-velour" onclick="scrollToProducts()">
                    <span>KHÁM PHÁ BỘ SƯU TẬP</span>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12H19M13 6L19 12L13 18"/>
                    </svg>
                </button>
                <button class="btn-secondary-velour" onclick="openChat()">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3L13.8 8.2L19 10L13.8 11.8L12 17L10.2 11.8L5 10L10.2 8.2L12 3Z"/>
                    </svg>
                    <span>TƯ VẤN PHỐI ĐỒ AI</span>
                </button>
            </div>
            <div class="hero-metrics">
                <div><strong>08+</strong><span>Thiết kế tuyển chọn</span></div>
                <div><strong>24/7</strong><span>Stylist AI miễn phí</span></div>
                <div><strong>14 ngày</strong><span>Đổi trả linh hoạt</span></div>
            </div>
        </div>

        <div class="hero-lookbook">
            <div class="lookbook-main" onclick="showProductModal(1)">
                <img src="/images/pastel_dress.jpg" alt="Đầm Xòe Xếp Bèo Pastel" />
                <div class="lookbook-caption">
                    <span>NỔI BẬT</span>
                    <strong>Đầm Xòe Xếp Bèo Pastel · 420,000 ₫</strong>
                </div>
            </div>
            <div class="lookbook-side">
                <div class="lookbook-mini" onclick="showProductModal(2)">
                    <img src="/images/korean_cardigan.jpg" alt="Áo Cardigan Len Dệt Kim Hàn Quốc" />
                    <div class="lookbook-mini-label">Áo Cardigan Len Dệt Kim</div>
                </div>
                <div class="lookbook-mini" onclick="showProductModal(5)">
                    <img src="/images/gothic_dress.jpg" alt="Đầm Nhung Đen Phối Corset Cổ Điển" />
                    <div class="lookbook-mini-label">Đầm Nhung Cổ Điển</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- VISUAL CATEGORY LOOKBOOK STRIP (REPLACES EMOJI CARDS) -->
<section class="section-wrap">
    <div class="section-head">
        <div>
            <div class="section-kicker">DANH MỤC NỔI BẬT</div>
            <h2 class="section-title">Chọn Theo Phong Cách & Trang Phục</h2>
        </div>
        <button class="link-quiet" onclick="filterCategory('All')">Xem toàn bộ danh mục</button>
    </div>

    <div class="categories-grid">
        <div class="category-card" data-cat="Váy đầm" onclick="filterCategory('Váy đầm')">
            <div class="cat-img-wrap"><img src="/images/pastel_dress.jpg" alt="Váy đầm thiết kế" /></div>
            <div class="cat-meta">
                <span class="cat-name">Váy Đầm Thiết Kế</span>
                <span class="cat-count">4 mẫu</span>
            </div>
        </div>
        <div class="category-card" data-cat="Áo khoác" onclick="filterCategory('Áo khoác')">
            <div class="cat-img-wrap"><img src="/images/korean_cardigan.jpg" alt="Áo khoác cardigan" /></div>
            <div class="cat-meta">
                <span class="cat-name">Áo Khoác & Cardigan</span>
                <span class="cat-count">1 mẫu</span>
            </div>
        </div>
        <div class="category-card" data-cat="Chân váy" onclick="filterCategory('Chân váy')">
            <div class="cat-img-wrap"><img src="/images/lace_skirt.jpg" alt="Chân váy midi" /></div>
            <div class="cat-meta">
                <span class="cat-name">Chân Váy Midi</span>
                <span class="cat-count">1 mẫu</span>
            </div>
        </div>
        <div class="category-card" data-cat="Áo" onclick="filterCategory('Áo')">
            <div class="cat-img-wrap"><img src="/images/puff_blouse.jpg" alt="Áo kiểu nữ tính" /></div>
            <div class="cat-meta">
                <span class="cat-name">Áo Kiểu Nữ Tính</span>
                <span class="cat-count">1 mẫu</span>
            </div>
        </div>
        <div class="category-card" data-cat="Đồ nam" onclick="filterCategory('Đồ nam')">
            <div class="cat-img-wrap"><img src="/images/linen_shirt.jpg" alt="Đồ nam tối giản" /></div>
            <div class="cat-meta">
                <span class="cat-name">Đồ Nam Tối Giản</span>
                <span class="cat-count">1 mẫu</span>
            </div>
        </div>
    </div>
</section>

<!-- PRODUCTS CATALOG GRID (4 COLUMNS, 3:4 PORTRAIT RATIO) -->
<section class="section-wrap" id="productsSection">
    <div class="section-head">
        <div>
            <div class="section-kicker">SẢN PHẨM</div>
            <h2 class="section-title" id="productSectionTitle">Tất cả sản phẩm</h2>
        </div>
        <div class="catalog-tools">
            <span class="product-count-label" id="productCountLabel">@Model.Products.Count sản phẩm</span>
            <button class="link-quiet" onclick="filterCategory('All')">Hiển thị tất cả</button>
        </div>
    </div>

    <div class="products-grid" id="productsGrid">
        @foreach (var p in Model.Products)
        {
            <article class="product-card">
                <div class="product-thumb" onclick="showProductModal(@p.Id)">
                    <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                    @if (p.Price < 350000)
                    {
                        <span class="product-tag tag-sale">GIÁ TỐT</span>
                    }
                    else if (p.Id <= 4)
                    {
                        <span class="product-tag">MỚI</span>
                    }

                    <button class="wish-btn @(p.IsWishlisted ? "active" : "")" onclick="event.stopPropagation(); toggleWishlist(@p.Id)" aria-label="Yêu thích">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="@(p.IsWishlisted ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 20.5C12 20.5 4 15.2 4 9.5C4 6.8 6.1 4.8 8.6 4.8C10.2 4.8 11.4 5.7 12 6.8C12.6 5.7 13.8 4.8 15.4 4.8C17.9 4.8 20 6.8 20 9.5C20 15.2 12 20.5 12 20.5Z"/>
                        </svg>
                    </button>

                    <div class="product-quick-bar" onclick="event.stopPropagation()">
                        <button class="btn-quick-cart" id="btn-cart-@p.Id" onclick="addToCart(@p.Id)">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 5V19M5 12H19"/>
                            </svg>
                            <span>Thêm vào giỏ</span>
                        </button>
                        <button class="btn-quick-ai" onclick="askAiAboutProduct(@p.Id)" title="Hỏi AI cách phối mẫu này">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3L13.8 8.2L19 10L13.8 11.8L12 17L10.2 11.8L5 10L10.2 8.2L12 3Z"/>
                            </svg>
                            <span>Phối đồ</span>
                        </button>
                    </div>
                </div>

                <div class="product-info">
                    <div class="product-cat">@p.Category</div>
                    <h3 class="product-name" onclick="showProductModal(@p.Id)">@p.Name</h3>
                    <div class="product-price">@p.FormattedPrice</div>
                </div>
            </article>
        }
    </div>
</section>

<!-- EDITORIAL PROMO BANNER -->
<section class="section-wrap">
    <div class="promo-banner" onclick="copyPromoCode()">
        <div class="promo-left">
            <span class="promo-kicker">ƯU ĐÃI THÀNH VIÊN MỚI</span>
            <h3 class="promo-title">Giảm 15% cho đơn hàng đầu tiên tại VELOUR</h3>
            <p class="promo-sub">Áp dụng cho toàn bộ thiết kế mới và dịch vụ tư vấn phối đồ cá nhân hóa.</p>
        </div>
        <div class="promo-right">
            <div class="promo-code-box">
                <span>MÃ ƯU ĐÃI</span>
                <strong>VELOUR15</strong>
            </div>
            <span class="promo-hint">Nhấn để sao chép</span>
        </div>
    </div>
</section>

<!-- SERVICE VALUE BAR (VECTOR LINE-ART ICONS) -->
<section class="value-strip">
    <div class="value-grid">
        <div class="value-item">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7H15V17H3V7Z"/><path d="M15 10H19L21 13V17H15V10Z"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
            </svg>
            <div>
                <strong>Miễn phí vận chuyển</strong>
                <span>Cho mọi đơn hàng từ 499.000₫</span>
            </div>
        </div>
        <div class="value-item">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 12A8 8 0 0 1 18.5 7.5M20 12A8 8 0 0 1 5.5 16.5"/><path d="M18.5 3.5V7.5H14.5M5.5 20.5V16.5H9.5"/>
            </svg>
            <div>
                <strong>Đổi trả trong 14 ngày</strong>
                <span>Hỗ trợ đổi size nhanh chóng</span>
            </div>
        </div>
        <div class="value-item">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3L13.8 8.2L19 10L13.8 11.8L12 17L10.2 11.8L5 10L10.2 8.2L12 3Z"/>
                <path d="M19 15L19.9 17.6L22.5 18.5L19.9 19.4L19 22L18.1 19.4L15.5 18.5L18.1 17.6L19 15Z"/>
            </svg>
            <div>
                <strong>Stylist AI cá nhân hóa</strong>
                <span>Tư vấn phối đồ theo dáng & dịp mặc</span>
            </div>
        </div>
        <div class="value-item">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3L19 6V11.5C19 16 15.8 19.8 12 21C8.2 19.8 5 16 5 11.5V6L12 3Z"/><path d="M9 12L11 14L15.5 9.5"/>
            </svg>
            <div>
                <strong>Chất liệu tuyển chọn</strong>
                <span>Voan tơ, linen, len dệt kim cao cấp</span>
            </div>
        </div>
    </div>
</section>

<!-- FOOTER -->
<footer class="site-footer">
    <div class="footer-grid">
        <div>
            <div class="footer-brand">VELOUR</div>
            <p class="footer-desc">Thương hiệu thời trang thiết kế tối giản kết hợp trợ lý phối đồ AI chạy cục bộ bằng ASP.NET Core (.NET 9) và Ollama.</p>
        </div>
        <div>
            <div class="footer-col-title">Danh mục</div>
            <a onclick="filterCategory('Váy đầm')">Váy đầm thiết kế</a>
            <a onclick="filterCategory('Áo')">Áo kiểu nữ tính</a>
            <a onclick="filterCategory('Chân váy')">Chân váy midi</a>
            <a onclick="filterCategory('Áo khoác')">Áo khoác & Cardigan</a>
        </div>
        <div>
            <div class="footer-col-title">Hỗ trợ khách hàng</div>
            <a onclick="openChat()">Tư vấn phối đồ AI</a>
            <a onclick="copyPromoCode()">Mã ưu đãi VELOUR15</a>
            <a onclick="toggleCartDrawer()">Kiểm tra giỏ hàng</a>
        </div>
        <div>
            <div class="footer-col-title">Đồ án 1 — Nhóm 9</div>
            <span>Lớp 75DCTT26</span>
            <span>ASP.NET Core .NET 9 · Ollama Qwen2.5 3B</span>
        </div>
    </div>
    <div class="footer-bottom">
        <span>© 2026 VELOUR Fashion Store. Thiết kế giao diện tối giản chuẩn thương hiệu.</span>
    </div>
</footer>

<!-- PRODUCT DETAIL MODAL -->
<div class="modal-backdrop" id="productModalBackdrop" onclick="closeProductModal()"></div>
<div class="product-modal" id="productModal" role="dialog" aria-modal="true" aria-labelledby="pmName">
    <button class="modal-close-btn" onclick="closeProductModal()" aria-label="Đóng">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <path d="M6 6L18 18M18 6L6 18"/>
        </svg>
    </button>
    <div class="pm-grid">
        <div class="pm-image-box">
            <img id="pmImg" src="" alt="" />
        </div>
        <div class="pm-body">
            <div class="pm-cat" id="pmCat"></div>
            <h2 class="pm-name" id="pmName"></h2>
            <div class="pm-price" id="pmPrice"></div>
            <p class="pm-desc" id="pmDesc"></p>

            <div class="pm-size-block">
                <div class="pm-size-label">Chọn kích cỡ</div>
                <div class="pm-sizes">
                    <button type="button" class="size-pill active" onclick="selectSize(this)">S</button>
                    <button type="button" class="size-pill" onclick="selectSize(this)">M</button>
                    <button type="button" class="size-pill" onclick="selectSize(this)">L</button>
                </div>
            </div>

            <div class="pm-actions">
                <button class="btn-primary-velour" id="pmAddCartBtn">THÊM VÀO GIỎ HÀNG</button>
                <button class="btn-secondary-velour" id="pmAskAiBtn">HỎI AI CÁCH PHỐI MẪU NÀY</button>
            </div>
        </div>
    </div>
</div>

<!-- CART OVERLAY & DRAWER -->
<div class="cart-overlay" id="cartOverlay" onclick="toggleCartDrawer()"></div>
<aside class="cart-drawer" id="cartDrawer" aria-label="Giỏ hàng">
    <div class="cart-header">
        <div class="cart-title-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 8H18L19.2 20H4.8L6 8Z"/><path d="M9 8V6.5C9 4.84 10.34 3.5 12 3.5C13.66 3.5 15 4.84 15 6.5V8"/>
            </svg>
            <h3>Giỏ hàng</h3>
        </div>
        <button class="btn-close-drawer" onclick="toggleCartDrawer()" aria-label="Đóng giỏ hàng">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
                <path d="M6 6L18 18M18 6L6 18"/>
            </svg>
        </button>
    </div>
    <div class="cart-items-body" id="cartItemsList"></div>
    <div class="cart-footer">
        <div class="cart-total-wrap">
            <span>Tạm tính</span>
            <span class="cart-total-price" id="cartTotalDisplay">0 ₫</span>
        </div>
        <button class="btn-checkout" onclick="checkoutOrder()">TIẾN HÀNH THANH TOÁN</button>
    </div>
</aside>

<!-- AI STYLIST CHAT WIDGET (VECTOR GRAPHICS ONLY) -->
<div class="chat-widget-wrap">
    <div class="chat-popup" id="chatPopup">
        <div class="chat-header">
            <div class="bot-info">
                <div class="bot-avatar" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3L13.8 8.2L19 10L13.8 11.8L12 17L10.2 11.8L5 10L10.2 8.2L12 3Z"/>
                        <path d="M19 15L19.8 17.2L22 18L19.8 18.8L19 21L18.2 18.8L16 18L18.2 17.2L19 15Z"/>
                    </svg>
                </div>
                <div>
                    <div class="bot-title">Velour AI Stylist</div>
                    <div class="bot-status"><span class="status-dot"></span>Trực tuyến · Tư vấn phối đồ</div>
                </div>
            </div>
            <div class="chat-ctrls">
                <button class="chat-ctrl-btn" title="Làm mới hội thoại" onclick="resetChatHistory()" aria-label="Làm mới hội thoại">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 12A8 8 0 0 1 18.5 7.5M20 12A8 8 0 0 1 5.5 16.5"/><path d="M18.5 3.5V7.5H14.5"/>
                    </svg>
                </button>
                <button class="chat-ctrl-btn" id="btnExpandChat" title="Phóng to / Thu nhỏ" onclick="toggleExpandChat()" aria-label="Phóng to">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3H21V9M9 21H3V15M21 3L14 10M3 21L10 14"/>
                    </svg>
                </button>
                <button class="chat-ctrl-btn" title="Đóng" onclick="toggleChat()" aria-label="Đóng khung chat">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
                        <path d="M6 6L18 18M18 6L6 18"/>
                    </svg>
                </button>
            </div>
        </div>

        <div class="chat-messages" id="chatMessages">
            <div class="msg-row bot">
                <div class="msg-bubble">
                    Xin chào bạn! Mình là <strong>Velour AI Stylist</strong>.<br>
                    Hãy cho mình biết dịp mặc, phong cách hoặc mức giá mong muốn — mình sẽ gợi ý mẫu trang phục và cách phối phù hợp nhất từ cửa hàng.
                </div>
            </div>
        </div>

        <div class="chat-typing" id="chatTyping">
            Velour AI đang chọn gợi ý phối đồ cho bạn...
        </div>

        <div class="chat-input-area">
            <input type="text" id="chatInput" placeholder="Nhập câu hỏi tư vấn phối đồ..." autocomplete="off" />
            <button class="btn-send-chat" onclick="sendChatMessage()" aria-label="Gửi tin nhắn">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 3L10 14M21 3L14.5 21L10 14L3 9.5L21 3Z"/>
                </svg>
            </button>
        </div>
    </div>

    <button class="chat-bubble-btn" onclick="toggleChat()" title="Trợ lý phối đồ Velour AI" aria-label="Mở trợ lý phối đồ AI">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3L13.8 8.2L19 10L13.8 11.8L12 17L10.2 11.8L5 10L10.2 8.2L12 3Z"/>
            <path d="M19 15L19.8 17.2L22 18L19.8 18.8L19 21L18.2 18.8L16 18L18.2 17.2L19 15Z"/>
        </svg>
        <span class="chat-fab-label">Stylist AI</span>
    </button>
</div>

<!-- TOAST NOTIFICATION -->
<div class="velour-toast" id="velourToast"></div>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
