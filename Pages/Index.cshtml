@page
@model IndexModel
@{
    ViewData["Title"] = "VELOUR DESIGN — Thời Trang Thiết Kế & Trợ Lý Phối Đồ AI";
}

<!-- STICKY HEADER (JM.COM.VN STYLE + VELOUR PURPLE TONE) -->
<header class="navbar">
    <div class="nav-container">
        <a class="brand-logo" onclick="filterCategory('All')" aria-label="VELOUR DESIGN Trang chủ">
            <div class="brand-monogram">
                <svg viewBox="0 0 42 26" width="38" height="24" fill="none" aria-hidden="true">
                    <path d="M4 4L13 22L22 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M25 4V21H37" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="35" cy="7" r="2" fill="#9E5FC0"/>
                </svg>
                <span class="brand-sub">VELOUR DESIGN</span>
            </div>
        </a>

        <nav class="nav-links" aria-label="Danh mục chính">
            <a class="cat-link active" data-cat="All" onclick="filterCategory('All')">
                <span class="nav-micro-tag">SALE</span>
                TRANG CHỦ
            </a>
            <a class="cat-link" data-cat="Đầm" onclick="filterCategory('Đầm')">ĐẦM</a>
            <a class="cat-link" data-cat="Áo" onclick="filterCategory('Áo')">ÁO</a>
            <a class="cat-link" data-cat="Quần" onclick="filterCategory('Quần')">QUẦN</a>
            <a class="cat-link" data-cat="Chân váy" onclick="filterCategory('Chân váy')">CHÂN VÁY</a>
            <a class="cat-link" data-cat="Áo khoác" onclick="filterCategory('Áo khoác')">ÁO KHOÁC</a>
            <a class="cat-link" data-cat="BST Mới" onclick="filterCategory('BST Mới')">BST MỚI</a>
            <a class="cat-link cat-sale" data-cat="Ưu đãi" onclick="filterCategory('Ưu đãi')">ƯU ĐÃI</a>
        </nav>

        <div class="nav-actions">
            <button class="nav-metric-btn" onclick="filterCategory('Yêu thích')" title="Sản phẩm yêu thích" aria-label="Yêu thích">
                <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20.5C12 20.5 4 15.2 4 9.5C4 6.8 6.1 4.8 8.6 4.8C10.2 4.8 11.4 5.7 12 6.8C12.6 5.7 13.8 4.8 15.4 4.8C17.9 4.8 20 6.8 20 9.5C20 15.2 12 20.5 12 20.5Z"/>
                </svg>
                <span id="wishBadge">0</span>
            </button>

            <button class="nav-metric-btn" onclick="toggleCartDrawer()" title="Giỏ hàng" aria-label="Giỏ hàng">
                <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 8H18L19.2 20H4.8L6 8Z"/>
                    <path d="M9 8V6.5C9 4.84 10.34 3.5 12 3.5C13.66 3.5 15 4.84 15 6.5V8"/>
                </svg>
                <span id="cartBadge">0</span>
            </button>

            <button class="nav-metric-btn nav-ai-pill" onclick="openChat()" title="Trợ lý phối đồ AI" aria-label="Stylist AI">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3L13.8 8.2L19 10L13.8 11.8L12 17L10.2 11.8L5 10L10.2 8.2L12 3Z"/>
                </svg>
                <span>AI Stylist</span>
            </button>
        </div>
    </div>
</header>

<!-- SUB-HEADER 3-COLUMN UTILITY STRIP (JM STYLE) -->
<div class="info-strip">
    <div class="info-strip-inner">
        <div class="info-strip-item" onclick="scrollToProducts()">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9L5 4H19L21 9"/><path d="M4 9V20H20V9"/><path d="M9 20V14H15V20"/>
            </svg>
            <span>Hệ thống cửa hàng</span>
        </div>
        <div class="info-strip-item" onclick="copyPromoCode()">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7H15V17H3V7Z"/><path d="M15 10H19L21 13V17H15V10Z"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
            </svg>
            <span>Miễn phí vận chuyển đơn từ 499K</span>
        </div>
        <div class="info-strip-item" onclick="openChat()">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3L13.8 8.2L19 10L13.8 11.8L12 17L10.2 11.8L5 10L10.2 8.2L12 3Z"/>
                <path d="M19 15L19.8 17.2L22 18L19.8 18.8L19 21L18.2 18.8L16 18L18.2 17.2L19 15Z"/>
            </svg>
            <span>Tư vấn phối đồ AI miễn phí 24/7</span>
        </div>
    </div>
</div>

<!-- FULL-WIDTH DREAMY HERO BANNER (JM STYLE + LAVENDER PURPLE) -->
<section class="hero-banner">
    <img class="hero-bg-img" src="/images/hero_banner.jpg" alt="Bộ sưu tập Giấc mơ dịu dàng - VELOUR DESIGN" />
    <div class="hero-overlay-grad"></div>

    <div class="hero-inner">
        <div class="hero-copy">
            <div class="hero-season">VELOUR DESIGN · XUÂN HÈ 2026</div>
            <h1 class="hero-script-title">Giấc mơ dịu dàng</h1>
            <p class="hero-lead">Bộ sưu tập thiết kế tông tím lavender thanh nhã cùng trợ lý AI Stylist gợi ý phối đồ theo dáng người.</p>
            <div class="hero-btn-row">
                <button class="btn-jm-pill" onclick="scrollToProducts()">
                    <span>XEM THÊM</span>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12H19M13 6L19 12L13 18"/>
                    </svg>
                </button>
                <button class="btn-jm-ai" onclick="openChat()">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3L13.8 8.2L19 10L13.8 11.8L12 17L10.2 11.8L5 10L10.2 8.2L12 3Z"/>
                    </svg>
                    <span>HỎI AI PHỐI ĐỒ</span>
                </button>
            </div>
        </div>
    </div>

    <!-- FLOATING SEARCH BAR AT BOTTOM OF HERO (JM SIGNATURE) -->
    <div class="hero-search-wrap">
        <div class="hero-search-bar">
            <input type="text" id="navSearch" placeholder="Bạn muốn tìm sản phẩm gì ? (VD: đầm voan, cardigan, chân váy...)" />
            <button class="hero-search-btn" onclick="triggerSearch()">Tìm kiếm ngay</button>
        </div>
    </div>
</section>

<!-- DASHED-CIRCLE GARMENT CATEGORY ICONS (JM SIGNATURE — 100% VECTOR SVG) -->
<section class="circle-cats-section">
    <div class="circle-cats-grid">
        <button class="circle-cat-item" data-cat="Đầm" onclick="filterCategory('Đầm')">
            <span class="circle-ring">
                <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 9L21 13H27L30 9L34 13L30 19L36 39H12L18 19L14 13L18 9Z"/>
                    <path d="M18 19H30"/><path d="M24 19V39"/>
                </svg>
            </span>
            <span class="circle-cat-label">ĐẦM</span>
        </button>

        <button class="circle-cat-item" data-cat="Áo" onclick="filterCategory('Áo')">
            <span class="circle-ring">
                <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 10L24 14L32 10L39 16L35 23L31 20V38H17V20L13 23L9 16L16 10Z"/>
                    <path d="M24 14V38"/>
                </svg>
            </span>
            <span class="circle-cat-label">ÁO</span>
        </button>

        <button class="circle-cat-item" data-cat="Quần" onclick="filterCategory('Quần')">
            <span class="circle-ring">
                <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 10H33L35 39H26L24 22L22 39H13L15 10Z"/>
                    <path d="M15 15H33"/>
                </svg>
            </span>
            <span class="circle-cat-label">QUẦN</span>
        </button>

        <button class="circle-cat-item" data-cat="Chân váy" onclick="filterCategory('Chân váy')">
            <span class="circle-ring">
                <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 12H32L37 37H11L16 12Z"/>
                    <path d="M16 16H32"/><path d="M20 16L18 37"/><path d="M28 16L30 37"/>
                </svg>
            </span>
            <span class="circle-cat-label">CHÂN VÁY</span>
        </button>

        <button class="circle-cat-item" data-cat="Áo khoác" onclick="filterCategory('Áo khoác')">
            <span class="circle-ring">
                <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 10L24 17L32 10L39 17L36 38H12L9 17L16 10Z"/>
                    <path d="M24 17V38"/><circle cx="21" cy="24" r="1"/><circle cx="21" cy="30" r="1"/>
                </svg>
            </span>
            <span class="circle-cat-label">ÁO KHOÁC</span>
        </button>

        <button class="circle-cat-item" data-cat="Ưu đãi" onclick="filterCategory('Ưu đãi')">
            <span class="circle-ring circle-ring-sale">
                <svg viewBox="0 0 48 48" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 24L24 11H36V23L23 36L11 24Z"/>
                    <circle cx="30" cy="17" r="2"/>
                </svg>
            </span>
            <span class="circle-cat-label">ƯU ĐÃI</span>
        </button>
    </div>
</section>

<!-- PRODUCTS SHOWCASE (JM CENTERED TITLE + 4-COL PORTRAIT STUDIO CARDS) -->
<section class="section-wrap" id="productsSection">
    <div class="section-head-center">
        <h2 class="section-title-center" id="productSectionTitle">SẢN PHẨM BÁN CHẠY</h2>
        <div class="section-sub-row">
            <span id="productCountLabel">@Model.Products.Count thiết kế</span>
            <span>·</span>
            <button class="link-quiet" onclick="filterCategory('All')">Xem tất cả</button>
        </div>
    </div>

    <div class="products-grid" id="productsGrid">
        @foreach (var p in Model.Products)
        {
            var badgeText = p.Price < 350000 ? "-15%" : (p.Id <= 4 ? "-5%" : "MỚI");
            var badgeClass = badgeText == "MỚI" ? "jm-badge badge-new" : "jm-badge badge-sale";
            <article class="product-card">
                <div class="product-thumb" onclick="showProductModal(@p.Id)">
                    <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                    <span class="@badgeClass">@badgeText</span>

                    <div class="product-quick-bar" onclick="event.stopPropagation()">
                        <button class="btn-quick-cart" id="btn-cart-@p.Id" onclick="addToCart(@p.Id)">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                                <path d="M12 5V19M5 12H19"/>
                            </svg>
                            <span>Thêm giỏ</span>
                        </button>
                        <button class="btn-quick-ai" onclick="askAiAboutProduct(@p.Id)" title="Hỏi AI cách phối mẫu này">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3L13.8 8.2L19 10L13.8 11.8L12 17L10.2 11.8L5 10L10.2 8.2L12 3Z"/>
                            </svg>
                            <span>Phối đồ AI</span>
                        </button>
                    </div>
                </div>

                <div class="product-info">
                    <div class="product-title-row">
                        <h3 class="product-name" onclick="showProductModal(@p.Id)" title="@p.Name">@p.Name</h3>
                        <button class="wish-inline-btn @(p.IsWishlisted ? "active" : "")" onclick="toggleWishlist(@p.Id)" aria-label="Yêu thích">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="@(p.IsWishlisted ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 20.5C12 20.5 4 15.2 4 9.5C4 6.8 6.1 4.8 8.6 4.8C10.2 4.8 11.4 5.7 12 6.8C12.6 5.7 13.8 4.8 15.4 4.8C17.9 4.8 20 6.8 20 9.5C20 15.2 12 20.5 12 20.5Z"/>
                            </svg>
                        </button>
                    </div>
                    <div class="product-meta-row">
                        <span class="product-price">@p.FormattedPrice</span>
                        <span class="product-cat-pill">@p.Category</span>
                    </div>
                </div>
            </article>
        }
    </div>
</section>

<!-- PROMO BANNER -->
<section class="section-wrap">
    <div class="promo-banner" onclick="copyPromoCode()">
        <div class="promo-left">
            <span class="promo-kicker">ĐẶC QUYỀN THÀNH VIÊN VELOUR</span>
            <h3 class="promo-title">Giảm ngay 15% cho đơn hàng đầu tiên</h3>
            <p class="promo-sub">Áp dụng cho toàn bộ bộ sưu tập thiết kế mới và miễn phí tư vấn phối đồ cùng Velour AI Stylist.</p>
        </div>
        <div class="promo-right">
            <div class="promo-code-box">
                <span>MÃ ƯU ĐÃI</span>
                <strong>VELOUR15</strong>
            </div>
            <span class="promo-hint">Nhấn để sao chép mã</span>
        </div>
    </div>
</section>

<!-- FOOTER -->
<footer class="site-footer">
    <div class="footer-grid">
        <div>
            <div class="footer-brand">VELOUR DESIGN</div>
            <p class="footer-desc">Thương hiệu thời trang thiết kế thanh lịch kết hợp trợ lý phối đồ AI chạy cục bộ bằng ASP.NET Core (.NET 9) và Ollama.</p>
        </div>
        <div>
            <div class="footer-col-title">Danh mục</div>
            <a onclick="filterCategory('Đầm')">Đầm thiết kế</a>
            <a onclick="filterCategory('Áo')">Áo kiểu nữ tính</a>
            <a onclick="filterCategory('Chân váy')">Chân váy midi</a>
            <a onclick="filterCategory('Áo khoác')">Áo khoác & Cardigan</a>
        </div>
        <div>
            <div class="footer-col-title">Hỗ trợ khách hàng</div>
            <a onclick="openChat()">Tư vấn phối đồ AI</a>
            <a onclick="copyPromoCode()">Mã ưu đãi VELOUR15</a>
            <a onclick="toggleCartDrawer()">Kiểm tra giỏ hàng</a>
        </div>
        <div>
            <div class="footer-col-title">Đồ án 1 — Nhóm 9</div>
            <span>Lớp 75DCTT26</span>
            <span>ASP.NET Core .NET 9 · Ollama Qwen2.5 3B</span>
        </div>
    </div>
    <div class="footer-bottom">
        <span>© 2026 VELOUR DESIGN. Thời trang thiết kế & Trợ lý phối đồ AI.</span>
    </div>
</footer>

<!-- PRODUCT DETAIL MODAL -->
<div class="modal-backdrop" id="productModalBackdrop" onclick="closeProductModal()"></div>
<div class="product-modal" id="productModal" role="dialog" aria-modal="true" aria-labelledby="pmName">
    <button class="modal-close-btn" onclick="closeProductModal()" aria-label="Đóng">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <path d="M6 6L18 18M18 6L6 18"/>
        </svg>
    </button>
    <div class="pm-grid">
        <div class="pm-image-box">
            <img id="pmImg" src="" alt="" />
        </div>
        <div class="pm-body">
            <div class="pm-cat" id="pmCat"></div>
            <h2 class="pm-name" id="pmName"></h2>
            <div class="pm-price" id="pmPrice"></div>
            <p class="pm-desc" id="pmDesc"></p>

            <div class="pm-size-block">
                <div class="pm-size-label">Chọn kích cỡ</div>
                <div class="pm-sizes">
                    <button type="button" class="size-pill active" onclick="selectSize(this)">S</button>
                    <button type="button" class="size-pill" onclick="selectSize(this)">M</button>
                    <button type="button" class="size-pill" onclick="selectSize(this)">L</button>
                </div>
            </div>

            <div class="pm-actions">
                <button class="btn-primary-velour" id="pmAddCartBtn">THÊM VÀO GIỎ HÀNG</button>
                <button class="btn-secondary-velour" id="pmAskAiBtn">HỎI AI CÁCH PHỐI MẪU NÀY</button>
            </div>
        </div>
    </div>
</div>

<!-- CART OVERLAY & DRAWER -->
<div class="cart-overlay" id="cartOverlay" onclick="toggleCartDrawer()"></div>
<aside class="cart-drawer" id="cartDrawer" aria-label="Giỏ hàng">
    <div class="cart-header">
        <div class="cart-title-wrap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 8H18L19.2 20H4.8L6 8Z"/><path d="M9 8V6.5C9 4.84 10.34 3.5 12 3.5C13.66 3.5 15 4.84 15 6.5V8"/>
            </svg>
            <h3>Giỏ hàng</h3>
        </div>
        <button class="btn-close-drawer" onclick="toggleCartDrawer()" aria-label="Đóng giỏ hàng">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
                <path d="M6 6L18 18M18 6L6 18"/>
            </svg>
        </button>
    </div>
    <div class="cart-items-body" id="cartItemsList"></div>
    <div class="cart-footer">
        <div class="cart-total-wrap">
            <span>Tạm tính</span>
            <span class="cart-total-price" id="cartTotalDisplay">0 ₫</span>
        </div>
        <button class="btn-checkout" onclick="checkoutOrder()">TIẾN HÀNH THANH TOÁN</button>
    </div>
</aside>

<!-- AI STYLIST CHAT WIDGET -->
<div class="chat-widget-wrap">
    <div class="chat-popup" id="chatPopup">
        <div class="chat-header">
            <div class="bot-info">
                <div class="bot-avatar" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3L13.8 8.2L19 10L13.8 11.8L12 17L10.2 11.8L5 10L10.2 8.2L12 3Z"/>
                        <path d="M19 15L19.8 17.2L22 18L19.8 18.8L19 21L18.2 18.8L16 18L18.2 17.2L19 15Z"/>
                    </svg>
                </div>
                <div>
                    <div class="bot-title">Velour AI Stylist</div>
                    <div class="bot-status"><span class="status-dot"></span>Trực tuyến · Tư vấn phối đồ</div>
                </div>
            </div>
            <div class="chat-ctrls">
                <button class="chat-ctrl-btn" title="Làm mới hội thoại" onclick="resetChatHistory()" aria-label="Làm mới hội thoại">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 12A8 8 0 0 1 18.5 7.5M20 12A8 8 0 0 1 5.5 16.5"/><path d="M18.5 3.5V7.5H14.5"/>
                    </svg>
                </button>
                <button class="chat-ctrl-btn" id="btnExpandChat" title="Phóng to / Thu nhỏ" onclick="toggleExpandChat()" aria-label="Phóng to">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3H21V9M9 21H3V15M21 3L14 10M3 21L10 14"/>
                    </svg>
                </button>
                <button class="chat-ctrl-btn" title="Đóng" onclick="toggleChat()" aria-label="Đóng khung chat">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
                        <path d="M6 6L18 18M18 6L6 18"/>
                    </svg>
                </button>
            </div>
        </div>

        <div class="chat-messages" id="chatMessages">
            <div class="msg-row bot">
                <div class="msg-bubble">
                    Xin chào bạn! Mình là <strong>Velour AI Stylist</strong>.<br>
                    Hãy cho mình biết dịp mặc, phong cách hoặc mức giá mong muốn — mình sẽ gợi ý mẫu trang phục và cách phối phù hợp nhất từ bộ sưu tập của VELOUR nhé!
                </div>
            </div>
        </div>

        <div class="chat-typing" id="chatTyping">
            Velour AI đang chọn gợi ý phối đồ cho bạn...
        </div>

        <div class="chat-input-area">
            <input type="text" id="chatInput" placeholder="Nhập câu hỏi tư vấn phối đồ..." autocomplete="off" />
            <button class="btn-send-chat" onclick="sendChatMessage()" aria-label="Gửi tin nhắn">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 3L10 14M21 3L14.5 21L10 14L3 9.5L21 3Z"/>
                </svg>
            </button>
        </div>
    </div>

    <button class="chat-bubble-btn" onclick="toggleChat()" title="Trợ lý phối đồ Velour AI" aria-label="Mở trợ lý phối đồ AI">
        <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3L13.8 8.2L19 10L13.8 11.8L12 17L10.2 11.8L5 10L10.2 8.2L12 3Z"/>
            <path d="M19 15L19.8 17.2L22 18L19.8 18.8L19 21L18.2 18.8L16 18L18.2 17.2L19 15Z"/>
        </svg>
        <span class="chat-fab-label">Stylist AI</span>
    </button>
</div>

